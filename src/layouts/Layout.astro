---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SplitEntranceOverlay from '../components/SplitEntranceOverlay.astro';
import { SITE_CONFIG } from '../lib/siteConfig';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE_CONFIG.name} — Premier Indian Catering, Buffets & Live Food Stalls`,
  description = SITE_CONFIG.description,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_CONFIG.url).href;
const ogImage = `${SITE_CONFIG.url}/images/anandham_logo.webp`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "CateringService"],
      "name": SITE_CONFIG.name,
      "url": SITE_CONFIG.url,
      "logo": ogImage,
      "image": ogImage,
      "description": SITE_CONFIG.description,
      "telephone": SITE_CONFIG.contacts.krishnan.phone1Raw,
      "email": SITE_CONFIG.email,
      "priceRange": "₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "66G, Rajiv Nagar, Moolapalayam",
        "addressLocality": "Erode",
        "addressRegion": "Tamil Nadu",
        "postalCode": "638002",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 11.341,
        "longitude": 77.7172
      },
      "areaServed": [
        { "@type": "State", "name": "Tamil Nadu" },
        { "@type": "City", "name": "Erode" },
        { "@type": "City", "name": "Madurai" },
        { "@type": "City", "name": "Thoothukudi" },
        { "@type": "City", "name": "Karaikudi" }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "1500"
      }
    }
  ]
};

const krishnanPhoneRaw = SITE_CONFIG.contacts.krishnan.phone1Raw;
const whatsappUrl = SITE_CONFIG.whatsappUrl;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/images/anandham_favicon.webp" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Anandham Catters, catering services Erode, wedding catering Tamil Nadu, live food stalls, buffet catering Erode, marriage catering Madurai, Thoothukudi catering, Karaikudi catering, South Indian virundhu" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / WhatsApp Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-ivory text-charcoal min-h-screen flex flex-col antialiased">
    <!-- Smooth 2-Half Split Open Entrance Overlay -->
    <SplitEntranceOverlay />

    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Compact Expandable Floating Call (Krishnan) & WhatsApp (Elango) Widgets -->
    <div class="fixed bottom-6 right-6 z-50 flex items-center gap-2.5">
      
      <!-- Compact Floating Call Button (Krishnan: 9786923184) -->
      <a
        href={`tel:${krishnanPhoneRaw}`}
        aria-label="Call Anandham Catters Hotline"
        class="group flex items-center justify-center h-11 px-3 rounded-full bg-crimson hover:bg-crimson-hover text-white shadow-xl transition-all duration-300 border border-gold/40 hover:px-4"
      >
        <svg class="w-4 h-4 text-gold fill-current shrink-0" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        <span class="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-300 text-[11px] uppercase tracking-wider font-semibold whitespace-nowrap opacity-0 group-hover:opacity-100 group-hover:ml-2">
          Call Us
        </span>
      </a>

      <!-- Authentic WhatsApp Symbol Floating Button (Elango: 9865295491) -->
      <div class="relative group">
        <div class="absolute -inset-1 rounded-full bg-[#25D366]/30 animate-ping pointer-events-none"></div>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Chat on WhatsApp with Anandham Catters"
          class="relative flex items-center justify-center h-11 px-3 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white shadow-xl transition-all duration-300 hover:px-4"
        >
          <!-- Authentic WhatsApp Logo SVG -->
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.944 9.944 0 001.341 5.011l-1.42 5.187 5.308-1.392a9.92 9.92 0 004.761 1.22h.005c5.507 0 9.99-4.478 9.99-9.985 0-2.667-1.038-5.175-2.925-7.062A9.914 9.914 0 0012.012 2zm.005 1.674c4.582 0 8.311 3.729 8.312 8.31a8.275 8.275 0 01-2.44 5.882 8.28 8.28 0 01-5.872 2.435h-.004a8.246 8.246 0 01-3.987-1.026l-.286-.17-2.96.776.79-2.885-.186-.296A8.257 8.257 0 013.696 11.984c0-4.581 3.73-8.31 8.321-8.31zm-3.666 4.385c-.205 0-.441.077-.672.333-.23.256-.88.86-.88 2.097 0 1.237.9 2.43 1.028 2.602.128.172 1.77 2.703 4.29 3.791 2.52 1.088 2.52.725 2.98.679.46-.046 1.482-.605 1.687-1.19.204-.585.204-1.085.143-1.189-.062-.104-.231-.167-.487-.295-.256-.128-1.482-.731-1.712-.815-.23-.084-.397-.128-.564.128-.166.256-.64.814-.784.978-.144.164-.287.185-.543.057-.256-.128-1.081-.399-2.06-1.272-.76-.678-1.274-1.515-1.423-1.771-.149-.256-.016-.394.112-.521.115-.115.256-.298.384-.447.128-.149.171-.256.256-.425.085-.17.043-.32-.021-.448-.064-.128-.564-1.36-.773-1.862-.204-.489-.411-.423-.564-.43-.145-.008-.311-.008-.477-.008z"/>
          </svg>
          <span class="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-300 text-[11px] uppercase tracking-wider font-semibold whitespace-nowrap opacity-0 group-hover:opacity-100 group-hover:ml-2">
            WhatsApp
          </span>
        </a>
      </div>

    </div>
  </body>
</html>
