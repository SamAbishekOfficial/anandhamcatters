---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../lib/siteConfig';

const BRANCH_CARDS = [
  {
    id: 'erode',
    name: 'Erode (Head Office)',
    shortLoc: 'Moolapalayam',
    address: '66G, Rajiv Nagar, Moolapalayam, Erode – 638002',
    isHQ: true,
  },
  {
    id: 'madurai',
    name: 'Madurai (Branch)',
    shortLoc: 'Othakadai',
    address: 'Othakadai, Anjali Oil Mill Opposite, Madurai – 625107',
    isHQ: false,
  },
  {
    id: 'thoothukudi',
    name: 'Thoothukudi (Branch)',
    shortLoc: 'Gomathi Bhai Colony',
    address: 'Gomathi Bhai Colony, Neero Building, Thoothukudi – 628001',
    isHQ: false,
  },
  {
    id: 'karaikudi',
    name: 'Karaikudi (Branch)',
    shortLoc: 'Ezhil Nagar',
    address: 'Ezhil Nagar, Karaikudi – 630002',
    isHQ: false,
  }
];

const elangoPhone = SITE_CONFIG.contacts.elango.phone;
const elangoPhoneRaw = SITE_CONFIG.contacts.elango.phoneRaw;
const krishnanPhone1 = SITE_CONFIG.contacts.krishnan.phone1;
const krishnanPhone1Raw = SITE_CONFIG.contacts.krishnan.phone1Raw;
const krishnanPhone2 = SITE_CONFIG.contacts.krishnan.phone2;
const krishnanPhone2Raw = SITE_CONFIG.contacts.krishnan.phone2Raw;
const whatsappUrl = SITE_CONFIG.whatsappUrl;
---

<Layout title="Contact Us — Reserve Anandham Catters">
  <!-- Top Minimal Hero Banner -->
  <section class="bg-charcoal text-ivory pt-14 pb-5 md:pt-24 md:pb-10 relative overflow-hidden">
    <!-- Subtle Ambient Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gold/5 blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-1.5 md:space-y-2 text-center">
      <span class="text-[9px] uppercase tracking-[0.25em] text-gold font-semibold block">
        DIRECT CATERING HOTLINE
      </span>
      <h1 class="font-editorial text-2xl md:text-5xl font-light">
        Contact <span class="italic text-gold">Anandham Catters</span>
      </h1>
      <p class="text-xs text-ivory/70 max-w-xl mx-auto font-light leading-relaxed">
        Reach out directly via Call or WhatsApp for instant date reservations and menu discussions across Tamil Nadu.
      </p>
    </div>
  </section>

  <!-- Sleek & Minimal 2-Card Layout -->
  <section class="max-w-5xl mx-auto px-3 md:px-6 lg:px-8 py-5 md:py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 items-stretch">
      
      <!-- Left Box: State Headquarters Minimal Card -->
      <div class="bg-ivory-card border border-gold/30 p-4 md:p-8 rounded-2xl md:rounded-3xl space-y-4 md:space-y-6 shadow-xl flex flex-col justify-between">
        
        <div class="space-y-2">
          <span class="text-[9px] uppercase tracking-[0.25em] font-bold text-gold-dark block">
            STATE HEADQUARTERS
          </span>
          <h2 class="font-editorial text-xl md:text-3xl text-charcoal font-light leading-tight">
            Erode <span class="italic text-crimson">Central Office</span>
          </h2>
          <p class="text-xs text-charcoal-muted font-light leading-relaxed">
            Centralized logistics command center deploying culinary teams to all 38 districts.
          </p>
        </div>

        <ul class="space-y-3 md:space-y-4 text-xs text-charcoal-light font-light border-y border-gold/20 py-3 md:py-4">
          
          <!-- Headquarters Address -->
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-gold-dark shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <div>
              <span class="block text-charcoal font-bold text-xs uppercase tracking-wider">HEADQUARTERS ADDRESS</span>
              <span class="text-charcoal-light leading-relaxed block pt-0.5">{SITE_CONFIG.branches[0].address}</span>
            </div>
          </li>

          <!-- Direct Hotline Numbers -->
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-gold-dark shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <div class="space-y-0.5">
              <span class="block text-charcoal font-bold text-xs uppercase tracking-wider">DIRECT HOTLINE NUMBERS</span>
              <div class="space-y-0.5 pt-0.5">
                <a href={`tel:${elangoPhoneRaw}`} class="text-crimson font-bold text-xs hover:underline block leading-snug">
                  {elangoPhone}
                </a>
                <a href={`tel:${krishnanPhone1Raw}`} class="text-charcoal hover:text-crimson font-bold text-xs block leading-snug">
                  {krishnanPhone1}
                </a>
                <a href={`tel:${krishnanPhone2Raw}`} class="text-charcoal hover:text-crimson font-bold text-xs block leading-snug">
                  {krishnanPhone2}
                </a>
              </div>
            </div>
          </li>

          <!-- Official Email -->
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-gold-dark shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <div>
              <span class="block text-charcoal font-bold text-xs uppercase tracking-wider">OFFICIAL EMAIL</span>
              <a href={`mailto:${SITE_CONFIG.email}`} class="text-charcoal hover:text-gold font-medium block pt-0.5">
                {SITE_CONFIG.email}
              </a>
            </div>
          </li>

        </ul>

        <!-- Minimal Action Buttons: Clean Buttons on Same Row or Stacked -->
        <div class="flex flex-row items-center gap-1.5 md:gap-2 pt-1">
          <a
            href={`tel:${krishnanPhone1Raw}`}
            class="flex-1 bg-crimson hover:bg-crimson-hover text-white text-[9px] md:text-[10px] uppercase tracking-wider md:tracking-widest py-2.5 px-2 md:py-3 md:px-3 rounded-lg md:rounded-xl font-bold transition-all shadow-md text-center flex items-center justify-center gap-1"
          >
            <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <span>CALL HOTLINE</span>
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-[#25D366] hover:bg-[#20ba5a] text-white text-[9px] md:text-[10px] uppercase tracking-wider md:tracking-widest py-2.5 px-2 md:py-3 md:px-3 rounded-lg md:rounded-xl font-bold transition-all shadow-md text-center flex items-center justify-center gap-1"
          >
            <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.944 9.944 0 001.341 5.011l-1.42 5.187 5.308-1.392a9.92 9.92 0 004.761 1.22h.005c5.507 0 9.99-4.478 9.99-9.985 0-2.667-1.038-5.175-2.925-7.062A9.914 9.914 0 0012.012 2zm.005 1.674c4.582 0 8.311 3.729 8.312 8.31a8.275 8.275 0 01-2.44 5.882 8.28 8.28 0 01-5.872 2.435h-.004a8.246 8.246 0 01-3.987-1.026l-.286-.17-2.96.776.79-2.885-.186-.296A8.257 8.257 0 013.696 11.984c0-4.581 3.73-8.31 8.321-8.31zm-3.666 4.385c-.205 0-.441.077-.672.333-.23.256-.88.86-.88 2.097 0 1.237.9 2.43 1.028 2.602.128.172 1.77 2.703 4.29 3.791 2.52 1.088 2.52.725 2.98.679.46-.046 1.482-.605 1.687-1.19.204-.585.204-1.085.143-1.189-.062-.104-.231-.167-.487-.295-.256-.128-1.482-.731-1.712-.815-.23-.084-.397-.128-.564.128-.166.256-.64.814-.784.978-.144.164-.287.185-.543.057-.256-.128-1.081-.399-2.06-1.272-.76-.678-1.274-1.515-1.423-1.771-.149-.256-.016-.394.112-.521.115-.115.256-.298.384-.447.128-.149.171-.256.256-.425.085-.17.043-.32-.021-.448-.064-.128-.564-1.36-.773-1.862-.204-.489-.411-.423-.564-.43-.145-.008-.311-.008-.477-.008z"/></svg>
            <span>WHATSAPP</span>
          </a>
        </div>

      </div>

      <!-- Right Box: Nice & Minimal Network Directory Card (Golden Location Vector Icons) -->
      <div class="bg-charcoal text-ivory p-4 md:p-8 rounded-2xl md:rounded-3xl border border-gold/30 space-y-4 md:space-y-5 shadow-2xl flex flex-col justify-between">
        
        <div class="space-y-3">
          <span class="text-[9px] uppercase tracking-[0.25em] font-bold text-gold block">
            NETWORK DIRECTORY
          </span>

          <h3 class="font-editorial text-xl md:text-2xl font-light leading-tight">
            Branches Across <span class="italic text-gold">Tamil Nadu</span>
          </h3>

          <p class="text-xs text-ivory/70 font-light leading-relaxed">
            Select any branch location below to view logistics details & address:
          </p>

          <!-- 4 Minimal Branch Selector Cards Grid (Golden Location Vector Icons - NO EMOJIS) -->
          <div class="grid grid-cols-2 gap-1.5 md:gap-2.5 pt-1">
            {BRANCH_CARDS.map((b, idx) => (
              <button
                type="button"
                data-contact-branch-btn={b.id}
                class={`p-3 rounded-xl border text-left transition-all duration-300 group cursor-pointer space-y-1 ${
                  idx === 0
                    ? 'border-gold bg-gold/15 text-gold'
                    : 'border-white/10 bg-white/5 hover:border-gold/50 hover:bg-gold/10 text-ivory'
                }`}
              >
                <div class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <h4 data-contact-branch-title class={`text-xs font-bold tracking-wide transition-colors ${idx === 0 ? 'text-gold' : 'text-ivory group-hover:text-gold'}`}>
                    {b.name}
                  </h4>
                </div>
                <span class="text-[10px] text-ivory/60 block truncate pl-5">{b.shortLoc}</span>
              </button>
            ))}
          </div>

          <!-- Minimal Dynamic Address Box -->
          <div id="contact-live-box" class="p-3.5 rounded-xl bg-black/50 border border-gold/30 space-y-1 transition-all duration-300">
            <div class="flex items-center justify-between">
              <span id="contact-live-name" class="text-xs font-bold text-gold uppercase tracking-wider">
                Erode (Head Office)
              </span>
              <span class="text-[8px] uppercase tracking-widest text-emerald-400 font-semibold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ACTIVE
              </span>
            </div>
            <p id="contact-live-address" class="text-xs text-ivory/80 font-light leading-relaxed">
              66G, Rajiv Nagar, Moolapalayam, Erode – 638002
            </p>
          </div>
        </div>

        <!-- Minimal Service Coverage Banner -->
        <div class="pt-3 border-t border-white/10 text-center">
          <span class="text-[10px] text-ivory/70 font-light tracking-wide">
            Primary Service Area: <strong class="text-gold font-semibold">All 38 Districts of Tamil Nadu</strong>
          </span>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script>
  // Minimal Switcher for Network Directory Card
  const branchData = [
    {
      id: 'erode',
      name: 'Erode (Head Office)',
      address: '66G, Rajiv Nagar, Moolapalayam, Erode – 638002'
    },
    {
      id: 'madurai',
      name: 'Madurai (Branch)',
      address: 'Othakadai, Anjali Oil Mill Opposite, Madurai – 625107'
    },
    {
      id: 'thoothukudi',
      name: 'Thoothukudi (Branch)',
      address: 'Gomathi Bhai Colony, Neero Building, Thoothukudi – 628001'
    },
    {
      id: 'karaikudi',
      name: 'Karaikudi (Branch)',
      address: 'Ezhil Nagar, Karaikudi – 630002'
    }
  ];

  const liveNameEl = document.getElementById('contact-live-name');
  const liveAddressEl = document.getElementById('contact-live-address');
  const branchBtns = document.querySelectorAll('[data-contact-branch-btn]');

  function activateBranchCard(id: string) {
    const target = branchData.find((b) => b.id === id);
    if (!target) return;

    if (liveNameEl) liveNameEl.textContent = target.name;
    if (liveAddressEl) liveAddressEl.textContent = target.address;

    branchBtns.forEach((btn) => {
      const btnId = btn.getAttribute('data-contact-branch-btn');
      const titleEl = btn.querySelector('[data-contact-branch-title]');

      if (btnId === id) {
        btn.className =
          'p-3 rounded-xl border text-left transition-all duration-300 group cursor-pointer space-y-1 border-gold bg-gold/15 text-gold';
        if (titleEl) titleEl.className = 'text-xs font-bold tracking-wide text-gold transition-colors';
      } else {
        btn.className =
          'p-3 rounded-xl border text-left transition-all duration-300 group cursor-pointer space-y-1 border-white/10 bg-white/5 hover:border-gold/50 hover:bg-gold/10 text-ivory';
        if (titleEl) titleEl.className = 'text-xs font-semibold tracking-wide text-ivory group-hover:text-gold transition-colors';
      }
    });
  }

  branchBtns.forEach((btn) => {
    const id = btn.getAttribute('data-contact-branch-btn');
    if (!id) return;
    btn.addEventListener('click', () => activateBranchCard(id));
    btn.addEventListener('mouseenter', () => activateBranchCard(id));
  });
</script>
