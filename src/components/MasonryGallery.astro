---
import { STALL_CATEGORIES } from '../lib/images';

// Select exactly 5 food stall cards for slots 1-5
const photos = STALL_CATEGORIES.flatMap((cat) =>
  cat.stalls.map((stall) => ({
    id: stall.id,
    src: stall.src,
    title: stall.title,
    category: cat.name,
    caption: stall.caption,
  }))
).slice(0, 5);
---

<div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-2.5 md:gap-6">
  {photos.map((item) => (
    <div class="relative group overflow-hidden rounded-xl md:rounded-3xl border border-gold/20 shadow-md hover:shadow-2xl transition-all duration-500 bg-charcoal aspect-[4/3]">
      <img
        src={item.src}
        alt={item.title}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 filter brightness-[0.92] group-hover:brightness-100"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/30 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-300"></div>

      <div class="absolute bottom-0 left-0 right-0 p-2.5 md:p-5 text-ivory space-y-0.5 md:space-y-1 z-10">
        <span class="text-[8px] md:text-[10px] uppercase tracking-widest text-gold font-medium block truncate">
          {item.category}
        </span>
        <h3 class="font-editorial text-xs md:text-xl font-normal leading-snug line-clamp-2">
          {item.title}
        </h3>
      </div>
    </div>
  ))}

  <!-- 6th Card Slot: Elegant "Explore for More" Card Button -->
  <a
    href="/live-stalls"
    class="relative group overflow-hidden rounded-xl md:rounded-3xl border border-gold/40 shadow-xl hover:shadow-2xl transition-all duration-500 bg-gradient-to-br from-charcoal via-charcoal-card to-black p-3 md:p-7 flex flex-col justify-between aspect-[4/3] hover:border-gold cursor-pointer"
  >
    <!-- Glowing Ambient Accent -->
    <div class="absolute -top-12 -right-12 w-40 h-40 bg-gold/15 rounded-full blur-2xl group-hover:bg-gold/25 transition-all"></div>

    <div class="space-y-1 md:space-y-2.5 relative z-10">
      <!-- Small Hollow Vector Icon -->
      <div class="w-5 h-5 md:w-8 md:h-8 rounded-full border border-gold/60 bg-transparent flex items-center justify-center text-gold group-hover:border-gold transition-all duration-300">
        <svg class="w-2.5 h-2.5 md:w-3.5 md:h-3.5 fill-none stroke-current" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
        </svg>
      </div>

      <span class="text-[7px] md:text-[9px] uppercase tracking-[0.2em] md:tracking-[0.25em] text-gold font-bold block">
        FULL EXPERIENCE
      </span>
      <h3 class="font-editorial text-xs md:text-2xl text-ivory font-light group-hover:text-gold transition-colors leading-tight">
        Explore <span class="italic text-gold">More</span>
      </h3>
      <p class="text-[9px] md:text-xs text-ivory/80 font-light leading-relaxed hidden md:block">
        Discover our complete collection of 19+ interactive food stalls, juice bars & royal live counters.
      </p>
    </div>

    <!-- Sleek & Optimal Compact Button -->
    <div class="pt-1 md:pt-2 relative z-10">
      <span class="inline-flex items-center gap-2 bg-crimson group-hover:bg-gold text-white group-hover:text-charcoal text-[9px] md:text-xs uppercase tracking-wider font-bold py-1.5 px-3.5 rounded-full shadow-md transition-all duration-300">
        <span>VIEW ALL</span>
        <span class="text-xs group-hover:translate-x-1 transition-transform">→</span>
      </span>
    </div>
  </a>
</div>
