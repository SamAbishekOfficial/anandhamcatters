---
import { SITE_CONFIG } from '../lib/siteConfig';

const ALL_OFFICES = [
  {
    id: 'erode',
    name: 'Erode (Head Office)',
    type: 'STATEWIDE HEADQUARTERS & NETWORK',
    address: '66G, Rajiv Nagar, Moolapalayam, Erode – 638002',
    isHQ: true,
    stats: [
      { label: 'SINCE', val: '2010', icon: '🛡️' },
      { label: 'EVENTS', val: '1.5 LAKH+', icon: '👥' },
      { label: 'GUESTS', val: '500M+', icon: '🚚' },
      { label: 'SERVICE', val: '16 YEARS', icon: '🏅' }
    ]
  },
  {
    id: 'thoothukudi',
    name: 'Thoothukudi (Branch)',
    type: 'COASTAL BRANCH OFFICE',
    address: 'Gomathi Bhai Colony, Neero Building, Thoothukudi – 628001',
    isHQ: false,
    stats: [
      { label: 'ESTD.', val: '2012', icon: '📍' },
      { label: 'EVENTS', val: '1 LAKH+', icon: '👥' },
      { label: 'GUESTS', val: '350M+', icon: '🚚' },
      { label: 'STATUS', val: 'ACTIVE', icon: '✨' }
    ]
  },
  {
    id: 'madurai',
    name: 'Madurai (Branch)',
    type: 'REGIONAL BRANCH OFFICE',
    address: 'Othakadai, Anjali Oil Mill Opposite, Madurai – 625107',
    isHQ: false,
    stats: [
      { label: 'ESTD.', val: '2013', icon: '📍' },
      { label: 'EVENTS', val: '10K+', icon: '👥' },
      { label: 'GUESTS', val: '35M+', icon: '🚚' },
      { label: 'STATUS', val: 'ACTIVE', icon: '✨' }
    ]
  },
  {
    id: 'karaikudi',
    name: 'Karaikudi (Branch)',
    type: 'CHETTINAD REGION BRANCH',
    address: 'Ezhil Nagar, Karaikudi – 630002',
    isHQ: false,
    stats: [
      { label: 'ESTD.', val: '2021', icon: '📍' },
      { label: 'EVENTS', val: '7K+', icon: '👥' },
      { label: 'GUESTS', val: '25M+', icon: '🚚' },
      { label: 'STATUS', val: 'ACTIVE', icon: '✨' }
    ]
  }
];

const phone = SITE_CONFIG.contacts.krishnan.phone1;
const phoneRaw = SITE_CONFIG.contacts.krishnan.phone1Raw;
const whatsappUrl = SITE_CONFIG.whatsappUrl;
---

<section class="py-8 sm:py-12 bg-charcoal text-ivory relative overflow-hidden flex flex-col justify-center">
  
  <!-- Subtle Ambient Top Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gold/5 blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6 w-full">

    <!-- Compact Section Title & Subtitle -->
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <div class="flex items-center justify-center gap-2">
        <div class="h-[1px] w-6 sm:w-12 bg-gold"></div>
        <span class="text-[9px] sm:text-xs uppercase tracking-[0.25em] text-gold font-semibold block">
          OUR PRESENCE ACROSS TAMIL NADU
        </span>
        <div class="h-[1px] w-6 sm:w-12 bg-gold"></div>
      </div>

      <h2 class="font-editorial text-2xl sm:text-5xl text-ivory font-light tracking-tight leading-tight">
        Serving Celebrations <span class="italic text-gold">Across the State</span>
      </h2>

      <p class="text-xs sm:text-sm text-ivory/70 max-w-lg mx-auto font-light leading-relaxed">
        From our headquarters in Erode to every corner of Tamil Nadu, we bring exceptional catering experiences to you.
      </p>
    </div>

    <!-- Single Frame Map & Office Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center pt-2">
      
      <!-- Left Column: Dark Tamil Nadu Map Card -->
      <div class="lg:col-span-7 relative bg-charcoal-card/90 p-4 sm:p-6 rounded-3xl border border-gold/30 shadow-[0_15px_40px_rgba(0,0,0,0.85)] backdrop-blur-xl flex items-center justify-center overflow-hidden min-h-[380px]">
        
        <!-- Centered Map Container -->
        <div class="relative w-full aspect-[4/3.5] max-w-[480px] max-h-[380px] sm:max-h-[420px] flex items-center justify-center mx-auto">
          
          <img
            src="/images/tamilnadu_glow.svg"
            alt="Tamil Nadu State Map"
            class="w-full h-full object-contain filter drop-shadow-[0_0_25px_rgba(201,168,76,0.35)] opacity-95 transform -translate-x-[15%] -translate-y-5 scale-[1.24] lg:scale-[1.16]"
          />

          <!-- 4 Interactive District Map Pins (Pushed Right to Align Perfectly with Map Outline) -->
          <!-- 1. Erode (Headquarters Pin) -->
          <div
            data-map-pin="erode"
            class="absolute top-[41%] left-[44%] transform -translate-x-1/2 -translate-y-1/2 z-30 group cursor-pointer"
          >
            <div class="relative flex items-center justify-center">
              <span class="absolute w-8 h-8 rounded-full bg-gold/40 animate-ping"></span>
              <div class="w-7 h-7 rounded-full bg-crimson border-2 border-gold flex items-center justify-center text-ivory shadow-[0_0_15px_rgba(201,168,76,0.9)] transform group-hover:scale-125 transition-transform duration-300">
                <svg class="w-3.5 h-3.5 text-gold fill-current" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
              </div>

              <!-- Hover Tooltip -->
              <div class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 hidden group-hover:flex flex-col items-center pointer-events-none z-40 whitespace-nowrap">
                <div class="bg-black/95 text-gold text-[10px] font-bold px-3 py-1 rounded-md border border-gold/60 shadow-xl">
                  ERODE (HEAD OFFICE) ★
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Madurai Pin -->
          <div
            data-map-pin="madurai"
            class="absolute top-[59%] left-[50%] transform -translate-x-1/2 -translate-y-1/2 z-30 group cursor-pointer"
          >
            <div class="relative flex items-center justify-center">
              <span class="absolute w-6 h-6 rounded-full bg-gold/30 animate-ping"></span>
              <div class="w-5.5 h-5.5 rounded-full bg-charcoal border-2 border-gold flex items-center justify-center text-gold shadow-md transform group-hover:scale-125 transition-transform duration-300">
                <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>

              <!-- Hover Tooltip -->
              <div class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 hidden group-hover:flex flex-col items-center pointer-events-none z-40 whitespace-nowrap">
                <div class="bg-black/95 text-gold text-[10px] font-bold px-3 py-1 rounded-md border border-gold/60 shadow-xl">
                  MADURAI (BRANCH)
                </div>
              </div>
            </div>
          </div>

          <!-- 3. Karaikudi Pin -->
          <div
            data-map-pin="karaikudi"
            class="absolute top-[58%] left-[60%] transform -translate-x-1/2 -translate-y-1/2 z-30 group cursor-pointer"
          >
            <div class="relative flex items-center justify-center">
              <span class="absolute w-6 h-6 rounded-full bg-gold/30 animate-ping"></span>
              <div class="w-5.5 h-5.5 rounded-full bg-charcoal border-2 border-gold flex items-center justify-center text-gold shadow-md transform group-hover:scale-125 transition-transform duration-300">
                <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>

              <!-- Hover Tooltip -->
              <div class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 hidden group-hover:flex flex-col items-center pointer-events-none z-40 whitespace-nowrap">
                <div class="bg-black/95 text-gold text-[10px] font-bold px-3 py-1 rounded-md border border-gold/60 shadow-xl">
                  KARAIKUDI (BRANCH)
                </div>
              </div>
            </div>
          </div>

          <!-- 4. Thoothukudi Pin -->
          <div
            data-map-pin="thoothukudi"
            class="absolute top-[73%] left-[54%] transform -translate-x-1/2 -translate-y-1/2 z-30 group cursor-pointer"
          >
            <div class="relative flex items-center justify-center">
              <span class="absolute w-6 h-6 rounded-full bg-gold/30 animate-ping"></span>
              <div class="w-5.5 h-5.5 rounded-full bg-charcoal border-2 border-gold flex items-center justify-center text-gold shadow-md transform group-hover:scale-125 transition-transform duration-300">
                <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>

              <!-- Hover Tooltip -->
              <div class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 hidden group-hover:flex flex-col items-center pointer-events-none z-40 whitespace-nowrap">
                <div class="bg-black/95 text-gold text-[10px] font-bold px-3 py-1 rounded-md border border-gold/60 shadow-xl">
                  THOOTHUKUDI (BRANCH)
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- Right Column: Interactive Office Details Card with 4-Metric Stats Grid -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- White Parchment Card -->
        <div id="office-details-card" class="bg-ivory-card border border-gold/40 p-5 sm:p-6 rounded-3xl space-y-3.5 shadow-xl transition-all duration-500">
          
          <div class="space-y-1">
            <span id="office-card-type" class="text-[9px] uppercase font-bold tracking-[0.22em] text-crimson block">
              {ALL_OFFICES[0].type}
            </span>
            <h3 id="office-card-name" class="font-editorial text-2xl sm:text-3xl text-charcoal font-normal leading-tight">
              {ALL_OFFICES[0].name}
            </h3>
          </div>

          <p class="text-xs text-charcoal-light font-light leading-relaxed flex items-start gap-1.5 min-h-[36px]">
            <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span id="office-card-address">{ALL_OFFICES[0].address}</span>
          </p>

          <!-- 4-Metric Stats Grid Restored -->
          <div id="office-card-stats" class="grid grid-cols-4 gap-1.5 pt-2 pb-1.5 border-t border-b border-charcoal/10 text-center">
            {ALL_OFFICES[0].stats.map((s, idx) => (
              <div class={`space-y-0.5 ${idx > 0 ? 'border-l border-charcoal/10' : ''}`}>
                <span class="text-xs text-gold font-bold block">{s.icon}</span>
                <span class="text-[8px] text-charcoal-muted uppercase tracking-wider block">{s.label}</span>
                <span class="text-[10px] sm:text-xs font-bold text-charcoal block">{s.val}</span>
              </div>
            ))}
          </div>

          <!-- Dual CTA Buttons -->
          <div class="pt-0.5 grid grid-cols-2 gap-2">
            <a
              href={`tel:${phoneRaw}`}
              class="bg-crimson hover:bg-crimson-hover text-white text-[10px] uppercase tracking-wider py-2.5 px-3 rounded-xl font-bold text-center shadow-md flex items-center justify-center gap-1.5 transition-all"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              <span>CALL HOTLINE</span>
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-[#25D366] hover:bg-[#20ba5a] text-white text-[10px] uppercase tracking-wider py-2.5 px-3 rounded-xl font-bold text-center shadow-md flex items-center justify-center gap-1.5 transition-all"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.944 9.944 0 001.341 5.011l-1.42 5.187 5.308-1.392a9.92 9.92 0 004.761 1.22h.005c5.507 0 9.99-4.478 9.99-9.985 0-2.667-1.038-5.175-2.925-7.062A9.914 9.914 0 0012.012 2zm.005 1.674c4.582 0 8.311 3.729 8.312 8.31a8.275 8.275 0 01-2.44 5.882 8.28 8.28 0 01-5.872 2.435h-.004a8.246 8.246 0 01-3.987-1.026l-.286-.17-2.96.776.79-2.885-.186-.296A8.257 8.257 0 013.696 11.984c0-4.581 3.73-8.31 8.321-8.31zm-3.666 4.385c-.205 0-.441.077-.672.333-.23.256-.88.86-.88 2.097 0 1.237.9 2.43 1.028 2.602.128.172 1.77 2.703 4.29 3.791 2.52 1.088 2.52.725 2.98.679.46-.046 1.482-.605 1.687-1.19.204-.585.204-1.085.143-1.189-.062-.104-.231-.167-.487-.295-.256-.128-1.482-.731-1.712-.815-.23-.084-.397-.128-.564.128-.166.256-.64.814-.784.978-.144.164-.287.185-.543.057-.256-.128-1.081-.399-2.06-1.272-.76-.678-1.274-1.515-1.423-1.771-.149-.256-.016-.394.112-.521.115-.115.256-.298.384-.447.128-.149.171-.256.256-.425.085-.17.043-.32-.021-.448-.064-.128-.564-1.36-.773-1.862-.204-.489-.411-.423-.564-.43-.145-.008-.311-.008-.477-.008z"/></svg>
              <span>WHATSAPP</span>
            </a>
          </div>

        </div>

        <!-- 4 Office Selector Buttons (2x2 Grid on Mobile) -->
        <div class="grid grid-cols-2 gap-1.5 md:gap-2">
          {ALL_OFFICES.map((off, index) => (
            <button
              type="button"
              data-office-btn={off.id}
              class={`p-2.5 rounded-2xl border text-ivory flex items-center justify-start gap-2 transition-all duration-300 group cursor-pointer text-left ${
                index === 0
                  ? 'border-gold bg-gold/20 shadow-[0_0_18px_rgba(201,168,76,0.35)] text-gold'
                  : 'border-gold/30 hover:border-gold bg-charcoal-card/90 hover:bg-gold/10'
              }`}
            >
              <svg class="w-3.5 h-3.5 text-gold shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span data-office-btn-text class={`text-xs font-semibold tracking-wide transition-colors ${index === 0 ? 'text-gold font-bold' : 'text-ivory group-hover:text-gold'}`}>
                {off.name}
              </span>
            </button>
          ))}
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  // Client-side Interactivity: Click or Hover on Office Buttons updates the White Card & Active Glow Effect
  const offices = [
    {
      id: 'erode',
      name: 'Erode (Head Office)',
      type: 'STATEWIDE HEADQUARTERS & NETWORK',
      address: '66G, Rajiv Nagar, Moolapalayam, Erode – 638002',
      stats: [
        { label: 'SINCE', val: '2010', icon: '🛡️' },
        { label: 'EVENTS', val: '1.5 LAKH+', icon: '👥' },
        { label: 'GUESTS', val: '500M+', icon: '🚚' },
        { label: 'SERVICE', val: '16 YEARS', icon: '🏅' }
      ]
    },
    {
      id: 'thoothukudi',
      name: 'Thoothukudi (Branch)',
      type: 'COASTAL BRANCH OFFICE',
      address: 'Gomathi Bhai Colony, Neero Building, Thoothukudi – 628001',
      stats: [
        { label: 'ESTD.', val: '2012', icon: '📍' },
        { label: 'EVENTS', val: '1 LAKH+', icon: '👥' },
        { label: 'GUESTS', val: '350M+', icon: '🚚' },
        { label: 'STATUS', val: 'ACTIVE', icon: '✨' }
      ]
    },
    {
      id: 'madurai',
      name: 'Madurai (Branch)',
      type: 'REGIONAL BRANCH OFFICE',
      address: 'Othakadai, Anjali Oil Mill Opposite, Madurai – 625107',
      stats: [
        { label: 'ESTD.', val: '2013', icon: '📍' },
        { label: 'EVENTS', val: '10K+', icon: '👥' },
        { label: 'GUESTS', val: '35M+', icon: '🚚' },
        { label: 'STATUS', val: 'ACTIVE', icon: '✨' }
      ]
    },
    {
      id: 'karaikudi',
      name: 'Karaikudi (Branch)',
      type: 'CHETTINAD REGION BRANCH',
      address: 'Ezhil Nagar, Karaikudi – 630002',
      stats: [
        { label: 'ESTD.', val: '2021', icon: '📍' },
        { label: 'EVENTS', val: '7K+', icon: '👥' },
        { label: 'GUESTS', val: '25M+', icon: '🚚' },
        { label: 'STATUS', val: 'ACTIVE', icon: '✨' }
      ]
    }
  ];

  const cardTypeEl = document.getElementById('office-card-type');
  const cardNameEl = document.getElementById('office-card-name');
  const cardAddressEl = document.getElementById('office-card-address');
  const cardStatsEl = document.getElementById('office-card-stats');
  const officeBtns = document.querySelectorAll('[data-office-btn]');

  function activateOffice(id: string) {
    const target = offices.find((o) => o.id === id);
    if (!target) return;

    if (cardTypeEl) cardTypeEl.textContent = target.type;
    if (cardNameEl) cardNameEl.textContent = target.name;
    if (cardAddressEl) cardAddressEl.textContent = target.address;

    if (cardStatsEl && target.stats) {
      cardStatsEl.innerHTML = target.stats
        .map(
          (s, idx) => `
        <div class="space-y-0.5 ${idx > 0 ? 'border-l border-charcoal/10' : ''}">
          <span class="text-xs text-gold font-bold block">${s.icon}</span>
          <span class="text-[8px] text-charcoal-muted uppercase tracking-wider block">${s.label}</span>
          <span class="text-[10px] sm:text-xs font-bold text-charcoal block">${s.val}</span>
        </div>
      `
        )
        .join('');
    }

    officeBtns.forEach((btn) => {
      const btnId = btn.getAttribute('data-office-btn');
      const textEl = btn.querySelector('[data-office-btn-text]');

      if (btnId === id) {
        btn.className =
          'p-2.5 rounded-2xl border text-ivory flex items-center justify-start gap-2 transition-all duration-300 group cursor-pointer text-left border-gold bg-gold/20 shadow-[0_0_18px_rgba(201,168,76,0.35)] text-gold';
        if (textEl) textEl.className = 'text-xs font-bold tracking-wide text-gold transition-colors';
      } else {
        btn.className =
          'p-2.5 rounded-2xl border text-ivory flex items-center justify-start gap-2 transition-all duration-300 group cursor-pointer text-left border-gold/30 hover:border-gold bg-charcoal-card/90 hover:bg-gold/10';
        if (textEl) textEl.className = 'text-xs font-semibold tracking-wide text-ivory group-hover:text-gold transition-colors';
      }
    });
  }

  officeBtns.forEach((btn) => {
    const id = btn.getAttribute('data-office-btn');
    if (!id) return;
    btn.addEventListener('click', () => activateOffice(id));
    btn.addEventListener('mouseenter', () => activateOffice(id));
  });

  const mapPins = document.querySelectorAll('[data-map-pin]');
  mapPins.forEach((pin) => {
    const id = pin.getAttribute('data-map-pin');
    if (!id) return;
    pin.addEventListener('click', () => activateOffice(id));
    pin.addEventListener('mouseenter', () => activateOffice(id));
  });
</script>
