---
import { SITE_CONFIG } from '../lib/siteConfig';

const pathname = Astro.url.pathname;

const NAV_LINKS = [
  { name: 'Home', href: '/', isHome: true },
  { name: 'Live Stalls', href: '/live-stalls', isHome: false },
  { name: 'Buffets', href: '/buffets', isHome: false },
  { name: 'About Us', href: '/about', isHome: false },
  { name: 'Contact', href: '/contact', isHome: false },
];
---

<!-- Navigation Header: Compact Solid Dark on Mobile, Translucent Frosted Glass on PC View -->
<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-[200] bg-charcoal border-b border-gold/30 md:bg-charcoal/40 md:backdrop-blur-md md:border-b md:border-gold/20 py-1.5 md:py-2 transition-all duration-300 shadow-xl md:shadow-lg"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    
    <!-- Brand Logo Link: Anandham Catters Logo (Compact) -->
    <a href="/" data-logo-link class="flex items-center gap-2 group">
      <div class="relative w-7 h-7 sm:w-8.5 sm:h-8.5 rounded-full overflow-hidden border border-gold/60 group-hover:border-gold transition-all shadow-md">
        <img
          src="/images/anandham_logo.webp"
          alt="Anandham Catters Logo"
          class="w-full h-full object-cover"
        />
      </div>
      <div>
        <span class="font-editorial text-base sm:text-xl tracking-wider text-ivory font-semibold block leading-none drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]">
          ANANDHAM
        </span>
        <span class="text-[8px] sm:text-[9px] tracking-[0.28em] text-gold uppercase font-semibold block leading-tight pt-0.5">
          CATTERS
        </span>
      </div>
    </a>

    <!-- Translucent High-Contrast Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7">
      {NAV_LINKS.map((link) => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            data-home-link={link.isHome ? "true" : undefined}
            class={`text-[11px] uppercase tracking-[0.18em] font-semibold transition-colors hover:text-gold relative py-1 drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] ${
              isActive ? 'text-gold' : 'text-ivory'
            }`}
          >
            {link.name}
            {isActive && (
              <span class="absolute bottom-0 left-0 right-0 h-[1.5px] bg-gold rounded-full shadow-gold" />
            )}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Action CTAs (Hidden on Mobile) -->
    <div class="hidden sm:flex items-center gap-2.5">
      <a
        href={`tel:${SITE_CONFIG.contacts.krishnan.phone1Raw}`}
        class="flex items-center gap-1.5 text-[11px] tracking-wider text-ivory hover:text-gold transition-colors font-semibold border border-gold/50 bg-black/40 hover:bg-black/60 px-3.5 py-1.5 rounded-full backdrop-blur-md shadow-md"
      >
        <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <span>Call</span>
      </a>

      <a
        href={SITE_CONFIG.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#25D366] hover:bg-[#20ba5a] text-white text-[11px] uppercase tracking-wider px-3.5 py-1.5 rounded-full font-semibold transition-all shadow-lg flex items-center gap-1.5"
      >
        <svg class="w-3 h-3 fill-white" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.891-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/></svg>
        <span>WhatsApp</span>
      </a>
    </div>

    <!-- Exclusive Luxury Mobile Menu Toggle Button (High-Contrast MENU + 3-Bar Icon) -->
    <button
      id="mobile-toggle"
      aria-label="Toggle Navigation Menu"
      class="md:hidden flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-charcoal/80 border border-white/20 text-ivory hover:border-gold/60 transition-all cursor-pointer font-bold text-xs uppercase tracking-widest active:scale-95 drop-shadow-md"
    >
      <span class="text-[10px] tracking-[0.2em]">MENU</span>
      <svg id="hamburger-icon" class="w-4 h-4 text-ivory shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="close-icon" class="w-4 h-4 text-gold shrink-0 hidden transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Compact Mobile Dropdown Panel (Not Full Page) -->
  <div
    id="mobile-drawer"
    class="absolute top-full left-0 right-0 z-[201] bg-[#141414] border-b border-gold/30 text-ivory shadow-2xl transition-all duration-300 max-h-0 overflow-hidden opacity-0 md:hidden"
  >
    <nav class="flex flex-col gap-1.5 p-3">
      {NAV_LINKS.map((link) => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            data-home-link={link.isHome ? "true" : undefined}
            class={`text-sm font-editorial tracking-wider py-2 px-3.5 rounded-lg transition-all flex items-center justify-between ${
              isActive
                ? 'bg-gold/20 text-gold border border-gold/50 font-bold'
                : 'text-ivory hover:text-gold hover:bg-white/5 border border-transparent'
            }`}
          >
            <span>{link.name}</span>
            {isActive && <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const mobileToggle = document.getElementById('mobile-toggle');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  window.addEventListener('scroll', () => {
    // Only apply scroll backdrop changes on desktop screens (md:)
    if (window.innerWidth >= 768) {
      if (window.scrollY > 30) {
        navbar?.classList.add('bg-charcoal/90', 'backdrop-blur-lg', 'border-b', 'border-gold/30');
        navbar?.classList.remove('bg-charcoal/40', 'border-gold/20');
      } else {
        navbar?.classList.remove('bg-charcoal/90', 'backdrop-blur-lg', 'border-b', 'border-gold/30');
        navbar?.classList.add('bg-charcoal/40', 'backdrop-blur-md', 'border-b', 'border-gold/20');
      }
    }
  });

  let drawerOpen = false;

  function toggleDrawer() {
    if (!mobileDrawer || !mobileToggle) return;
    drawerOpen = !drawerOpen;
    if (drawerOpen) {
      mobileDrawer.style.maxHeight = mobileDrawer.scrollHeight + 'px';
      mobileDrawer.classList.remove('opacity-0');
      mobileDrawer.classList.add('opacity-100');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');

      // Active Gold State when Open
      mobileToggle.classList.add('border-gold', 'text-gold', 'bg-gold/20', 'shadow-[0_0_15px_rgba(212,175,55,0.4)]');
      mobileToggle.classList.remove('border-white/20', 'text-ivory', 'bg-charcoal/80');
    } else {
      mobileDrawer.style.maxHeight = '0';
      mobileDrawer.classList.add('opacity-0');
      mobileDrawer.classList.remove('opacity-100');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');

      // Revert to Unclicked/Inactive State when Closed
      mobileToggle.classList.remove('border-gold', 'text-gold', 'bg-gold/20', 'shadow-[0_0_15px_rgba(212,175,55,0.4)]');
      mobileToggle.classList.add('border-white/20', 'text-ivory', 'bg-charcoal/80');
    }
  }

  mobileToggle?.addEventListener('click', toggleDrawer);
</script>
