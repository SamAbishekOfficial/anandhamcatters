---
import { SITE_CONFIG } from '../lib/siteConfig';

const elangoPhone = SITE_CONFIG.contacts.elango.phone;
const elangoPhoneRaw = SITE_CONFIG.contacts.elango.phoneRaw;
const krishnanPhone1 = SITE_CONFIG.contacts.krishnan.phone1;
const krishnanPhone1Raw = SITE_CONFIG.contacts.krishnan.phone1Raw;
const krishnanPhone2 = SITE_CONFIG.contacts.krishnan.phone2;
const krishnanPhone2Raw = SITE_CONFIG.contacts.krishnan.phone2Raw;
---

<footer class="bg-charcoal text-ivory/80 py-8 sm:py-12 border-t border-gold/30 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
    
    <!-- Responsive Grid: Compact 2-Column on Mobile, Generous 4-Column on Desktop -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10 text-xs pb-6 border-b border-white/10">
      
      <!-- Brand Info (Spans 2 columns on mobile, 1 on desktop) -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <a href="/" data-logo-link class="flex items-center gap-3 group inline-flex">
          <div class="relative w-8 h-8 md:w-10 md:h-10 rounded-full overflow-hidden border border-gold shadow-md">
            <img
              src="/images/anandham_logo.webp"
              alt="Anandham Catters Logo"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <span class="font-editorial text-lg md:text-2xl tracking-wider text-ivory font-semibold block leading-none">
              ANANDHAM
            </span>
            <span class="text-[9px] md:text-xs tracking-[0.28em] text-gold uppercase font-semibold block leading-tight pt-0.5">
              CATTERS
            </span>
          </div>
        </a>
        <p class="text-[11px] md:text-sm text-ivory/70 leading-relaxed font-light max-w-xs">
          Tamil Nadu’s premier culinary brand for grand banana leaf banquets, royal buffets & live food stalls.
        </p>
      </div>

      <!-- Quick Navigation -->
      <div class="space-y-3">
        <h3 class="font-editorial text-xs md:text-base text-gold tracking-widest uppercase font-semibold border-b border-gold/30 pb-1 inline-block">
          Navigation
        </h3>
        <ul class="space-y-2 text-[11px] md:text-sm text-ivory/80">
          <li><a href="/" data-home-link="true" class="hover:text-gold transition-colors block py-0.5">Home</a></li>
          <li><a href="/live-stalls" class="hover:text-gold transition-colors block py-0.5">Live Stalls</a></li>
          <li><a href="/buffets" class="hover:text-gold transition-colors block py-0.5">Buffet Setups</a></li>
          <li><a href="/about" class="hover:text-gold transition-colors block py-0.5">About Us</a></li>
          <li><a href="/contact" class="hover:text-gold transition-colors block py-0.5">Contact Us</a></li>
        </ul>
      </div>

      <!-- Direct Contact -->
      <div class="space-y-3">
        <h3 class="font-editorial text-xs md:text-base text-gold tracking-widest uppercase font-semibold border-b border-gold/30 pb-1 inline-block">
          Contact Info
        </h3>
        <ul class="space-y-2.5 text-[11px] md:text-sm text-ivory/80">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 md:w-5 md:h-5 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="leading-tight md:text-sm">Erode (Head Office), Tamil Nadu</span>
          </li>

          <!-- Phone Numbers -->
          <li class="flex items-start gap-2 pt-0.5">
            <svg class="w-4 h-4 md:w-5 md:h-5 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <div class="space-y-1">
              <a href={`tel:${elangoPhoneRaw}`} class="hover:text-gold transition-colors font-bold text-gold block leading-tight text-xs md:text-base">
                {elangoPhone} <span class="text-[10px] md:text-xs font-normal text-ivory/60">(Elango)</span>
              </a>
              <a href={`tel:${krishnanPhone1Raw}`} class="hover:text-gold transition-colors font-semibold text-ivory/90 block leading-tight text-xs md:text-sm">
                {krishnanPhone1} <span class="text-[10px] md:text-xs font-normal text-ivory/60">(Krishnan)</span>
              </a>
              <a href={`tel:${krishnanPhone2Raw}`} class="hover:text-gold transition-colors font-semibold text-ivory/90 block leading-tight text-xs md:text-sm">
                {krishnanPhone2}
              </a>
            </div>
          </li>

          <li class="flex items-center gap-2 truncate pt-0.5">
            <svg class="w-4 h-4 md:w-5 md:h-5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-gold transition-colors truncate text-xs md:text-sm">
              {SITE_CONFIG.email}
            </a>
          </li>
        </ul>
      </div>

      <!-- Branch Directory -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <h3 class="font-editorial text-xs md:text-base text-gold tracking-widest uppercase font-semibold border-b border-gold/30 pb-1 inline-block">
          Branch Network
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-1 gap-2 text-xs">
          {SITE_CONFIG.branches.map((b) => (
            <div class="px-3 py-2 rounded-md bg-white/[0.04] border border-gold/20 hover:border-gold/60 transition-all flex items-center justify-between text-ivory group">
              <span class="font-semibold text-gold text-xs md:text-sm group-hover:translate-x-0.5 transition-transform">{b.city}</span>
              <span class="text-[9px] md:text-[10px] text-ivory/50 font-medium uppercase tracking-wider shrink-0 ml-2">{b.isHQ ? 'HQ' : 'Branch'}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Bottom Line -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] md:text-xs text-ivory/50 md:pr-28">
      <p>© {new Date().getFullYear()} Anandham Catters. All rights reserved.</p>
      <div class="flex items-center gap-4 text-ivory/70 md:text-xs">
        <a href={`tel:${krishnanPhone1Raw}`} class="hover:text-gold transition-colors">Call Direct</a>
        <span>•</span>
        <a href={SITE_CONFIG.whatsappUrl} target="_blank" class="hover:text-gold transition-colors">WhatsApp Direct</a>
      </div>
    </div>
  </div>
</footer>
