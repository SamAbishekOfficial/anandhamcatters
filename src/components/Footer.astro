---
import { SITE_CONFIG } from '../lib/siteConfig';

const elangoPhone = SITE_CONFIG.contacts.elango.phone;
const elangoPhoneRaw = SITE_CONFIG.contacts.elango.phoneRaw;
const krishnanPhone1 = SITE_CONFIG.contacts.krishnan.phone1;
const krishnanPhone1Raw = SITE_CONFIG.contacts.krishnan.phone1Raw;
const krishnanPhone2 = SITE_CONFIG.contacts.krishnan.phone2;
const krishnanPhone2Raw = SITE_CONFIG.contacts.krishnan.phone2Raw;
---

<footer class="bg-charcoal text-ivory/80 py-6 sm:py-10 border-t border-gold/30 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
    
    <!-- Compact 2-Column Grid on Mobile for Single Page Visibility -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs pb-4 border-b border-white/10">
      
      <!-- Brand Info (Spans 2 columns on mobile) -->
      <div class="col-span-2 md:col-span-1 space-y-2">
        <a href="/" data-logo-link class="flex items-center gap-2 group inline-flex">
          <div class="relative w-7 h-7 rounded-full overflow-hidden border border-gold">
            <img
              src="/images/anandham_logo.webp"
              alt="Anandham Catters Logo"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <span class="font-editorial text-lg tracking-wider text-ivory font-semibold block leading-none">
              ANANDHAM
            </span>
            <span class="text-[9px] tracking-[0.25em] text-gold uppercase font-semibold block leading-tight pt-0.5">
              CATTERS
            </span>
          </div>
        </a>
        <p class="text-[10px] text-ivory/70 leading-relaxed font-light">
          Tamil Nadu’s premier culinary brand for grand banquets & live stalls.
        </p>
      </div>

      <!-- Quick Navigation -->
      <div class="space-y-1.5">
        <h3 class="font-editorial text-xs text-gold tracking-wide uppercase font-semibold border-b border-gold/30 pb-1 inline-block">
          Navigation
        </h3>
        <ul class="space-y-1 text-[11px]">
          <li><a href="/" data-home-link="true" class="hover:text-gold transition-colors">Home</a></li>
          <li><a href="/live-stalls" class="hover:text-gold transition-colors">Live Stalls</a></li>
          <li><a href="/buffets" class="hover:text-gold transition-colors">Buffet Setups</a></li>
          <li><a href="/about" class="hover:text-gold transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-gold transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Direct Contact (All 3 Phone Numbers Displayed Line-by-Line Below) -->
      <div class="space-y-1.5">
        <h3 class="font-editorial text-xs text-gold tracking-wide uppercase font-semibold border-b border-gold/30 pb-1 inline-block">
          Contact Info
        </h3>
        <ul class="space-y-1 text-[10px] text-ivory/80">
          <li class="flex items-start gap-1.5">
            <svg class="w-3.5 h-3.5 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="leading-tight">Erode (HQ), Tamil Nadu</span>
          </li>

          <!-- All 3 Phone Numbers Displayed Line-by-Line -->
          <li class="flex items-start gap-1.5 pt-0.5">
            <svg class="w-3.5 h-3.5 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <div class="space-y-0.5">
              <a href={`tel:${elangoPhoneRaw}`} class="hover:text-gold transition-colors font-bold text-gold block leading-tight">
                {elangoPhone}
              </a>
              <a href={`tel:${krishnanPhone1Raw}`} class="hover:text-gold transition-colors font-semibold text-ivory block leading-tight">
                {krishnanPhone1}
              </a>
              <a href={`tel:${krishnanPhone2Raw}`} class="hover:text-gold transition-colors font-semibold text-ivory block leading-tight">
                {krishnanPhone2}
              </a>
            </div>
          </li>

          <li class="flex items-center gap-1.5 truncate pt-0.5">
            <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-gold transition-colors truncate">
              {SITE_CONFIG.email}
            </a>
          </li>
        </ul>
      </div>

      <!-- Branch Directory (Compact Pill Grid) -->
      <div class="col-span-2 md:col-span-1 space-y-1.5">
        <h3 class="font-editorial text-xs text-gold tracking-wide uppercase font-semibold border-b border-gold/30 pb-1 inline-block">
          Branches
        </h3>
        <div class="grid grid-cols-2 gap-1.5 text-[10px]">
          {SITE_CONFIG.branches.map((b) => (
            <div class="px-2 py-1 rounded bg-white/5 border border-white/5 text-ivory/80 truncate">
              <span class="font-medium text-gold">{b.name.split(' ')[0]}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Ultra-Compact Bottom Line -->
    <div class="flex flex-row items-center justify-between text-[10px] text-ivory/50">
      <p>© {new Date().getFullYear()} Anandham Catters</p>
      <div class="flex items-center gap-3">
        <a href={`tel:${krishnanPhone1Raw}`} class="hover:text-gold">Call</a>
        <span>•</span>
        <a href={SITE_CONFIG.whatsappUrl} target="_blank" class="hover:text-gold">WhatsApp</a>
      </div>
    </div>
  </div>
</footer>
