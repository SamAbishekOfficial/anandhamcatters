---
const FAQS = [
  {
    question: "What scale of events does Anandham Catters cater to?",
    answer: "We specialize in both intimate gatherings starting from 100 guests up to massive royal wedding banquets catering to over 5,000+ guests with synchronized hospitality."
  },
  {
    question: "Do you offer live food stalls and interactive cooking counters?",
    answer: "Yes! We offer live Pani Puri & Chaat counters, Chocolate Fountains, Fresh Juice Bars, 90s Petty Shop counters, Live Kulfi & Ice Cream bars, and Royal Meetha Paan stations."
  },
  {
    question: "Where are Anandham Catters services available?",
    answer: "Our primary state headquarters is in Erode, Tamil Nadu, with active branch offices in Madurai, Thoothukudi, and Karaikudi. We deploy live stalls and catering logistics across all 38 districts in Tamil Nadu."
  },
  {
    question: "Can we customize the wedding menu for banana leaf and buffet services?",
    answer: "Absolutely. Every menu is custom crafted based on your family traditions, regional authentic recipes, dietary needs, and fusion preferences."
  },
  {
    question: "How far in advance should we book Anandham Catters for an event?",
    answer: "For peak wedding dates, we recommend booking 2 to 4 months in advance to guarantee date availability and live stall setup allocations."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="py-8 sm:py-14 bg-ivory relative">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-1.5 mb-6 sm:mb-8">
      <span class="text-[10px] sm:text-[11px] uppercase tracking-[0.25em] text-gold font-medium block">
        Clear Insights & Answers
      </span>
      <h2 class="font-editorial text-2xl sm:text-4xl text-charcoal font-normal">
        Frequently Asked <span class="italic text-crimson">Questions</span>
      </h2>
    </div>

    <div class="space-y-3">
      {FAQS.map((faq) => (
        <details class="group rounded-xl border border-gold/30 bg-ivory-card p-4 sm:p-5 [&_summary::-webkit-details-marker]:hidden shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between gap-3 font-editorial text-base sm:text-xl text-charcoal font-normal">
            <span>{faq.question}</span>
            <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-gold">
              <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <p class="mt-3 leading-relaxed text-xs sm:text-sm text-charcoal-light font-light border-t border-gold/20 pt-3">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
